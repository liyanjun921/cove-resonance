# Cove Bridge
NODE_ENV=production
PORT=8787

# Public HTTPS origin only, without /mcp.
# Required for MCP App CSP and Listener SSE.
BRIDGE_PUBLIC_ORIGIN=https://bridge.example.com

# Required for production public MCP endpoints. Never commit a real value.
COVE_MCP_ACCESS_TOKEN=replace-with-a-long-random-secret
# Owner-facing OAuth login; password is entered ONLY in the HTTPS authorization page.
COVE_OAUTH_PASSWORD=replace-with-a-strong-secret-of-at-least-16-characters
# Stable signing key for OAuth dynamic client registrations (min 32 chars).
COVE_OAUTH_SIGNING_SECRET=replace-with-an-independent-random-secret-32-chars-minimum

# Required for production generic /events protection.
BRIDGE_INGEST_TOKEN=change-me-to-a-long-random-value

# Optional Unix socket. Leave empty when reverse proxying to 127.0.0.1:8787.
BRIDGE_UNIX_SOCKET=

# NetEase Listen Together
TOGETHER_ENABLED=true
TOGETHER_POLL_INTERVAL_MS=4000
TOGETHER_HEARTBEAT_INTERVAL_MS=10000

# Optional: only handle invitations from one account.
NETEASE_INVITER_UID=

# Keep this secret. At minimum it should contain MUSIC_U.
NETEASE_COOKIE=MUSIC_U=replace-with-your-own-session-cookie
